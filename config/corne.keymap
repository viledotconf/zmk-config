#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/rgb.h>

&mt {
    flavor = "tap-preferred";
    retro-tap;
};

/ {
    behaviors {
        bt0_rgb: bt0_rgb {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 0 &rgb_ug RGB_COLOR_HSB(300,100,5)>;
        };
        bt1_rgb: bt1_rgb {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 1 &rgb_ug RGB_COLOR_HSB(180,100,5)>;
        };
        bt2_rgb: bt2_rgb {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 2 &rgb_ug RGB_COLOR_HSB(0,100,5)>;
        };
        bt3_rgb: bt3_rgb {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 3 &rgb_ug RGB_COLOR_HSB(120,100,5)>;
        };
        bt4_rgb: bt4_rgb {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 4 &rgb_ug RGB_COLOR_HSB(45,100,5)>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        Main {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  Q  |  W  |  E  |  R  |  T  |   |  Y  |  U   |  I  |  O  |  P  | BKSP |
            // | CTRL |  A  |  S  |  D  |  F  |  G  |   |  H  |  J   |  K  |  L  |  ;  |  '   |
            // | SHFT |  Z  |  X  |  C  |  V  |  B  |   |  N  |  M   |  ,  |  .  |  /  | ESC  |
            //                    | GUI | LWR | SPC |   | ENT | RSE  | ALT |

            bindings = <
&none  &kp ESC           &kp COMMA        &kp DOT             &kp P               &kp Y          &kp F          &kp G                &kp C                &kp R            &kp L             &none
&none  &mt LEFT_SHIFT A  &mt RIGHT_ALT O  &mt LEFT_CONTROL E  &mt LEFT_COMMAND U  &kp I          &kp D          &mt RIGHT_COMMAND H  &mt RIGHT_CONTROL T  &mt RIGHT_ALT N  &mt LEFT_SHIFT S  &none
&none  &kp SEMI          &kp Q            &kp J               &kp K               &kp X          &kp B          &kp M                &kp W                &kp V            &kp Z             &none
                                          &mo 4               &mo 1               &lt 2 SPACE    &kp BACKSPACE  &mo 3                &kp TAB
            >;

            label = "Dvorak";
        };

        S1 {
            bindings = <
&none  &kp GRAVE       &kp AT     &kp HASH   &kp PERCENT  &none       &kp PLUS      &kp LEFT_BRACKET      &kp RIGHT_BRACKET      &kp EQUAL      &none            &none
&none  &kp LEFT_SHIFT  &kp PIPE   &kp EXCL   &kp APOS     &kp AMPS    &kp MINUS     &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp SLASH      &kp RIGHT_SHIFT  &none
&none  &none           &kp TILDE  &kp CARET  &kp COLON    &none       &kp ASTRK     &kp QUESTION          &kp DOLLAR             &kp BACKSLASH  &none            &none
                                  &none      &none        &none       &kp LEFT_GUI  &kp RALT              &kp LEFT_CONTROL
            >;

            label = "Symbols";
        };

        Movement {
            bindings = <
&none  &kp ESC    &none         &none             &none     &none      &none       &none      &kp CAPS       &none        &none      &none
&none  &kp LSHFT  &kp LEFT_ALT  &kp LEFT_CONTROL  &kp LGUI  &kp TAB    &kp DELETE  &kp LEFT   &kp DOWN       &kp UP       &kp RIGHT  &none
&none  &none      &none         &none             &none     &none      &none       &kp HOME   &kp PAGE_DOWN  &kp PAGE_UP  &kp END    &none
                                &none             &none     &none      &kp ENTER   &kp SPACE  &none
            >;

            label = "Movement";
        };

        Numpad {
            bindings = <
&none  &none  &kp N7        &kp N8        &kp N9        &none        &none          &kp PLUS              &kp MINUS              &kp ASTERISK   &kp SLASH        &none
&none  &none  &kp NUMBER_4  &kp N5        &kp NUMBER_6  &none        &none          &kp RIGHT_GUI         &kp RIGHT_CONTROL      &kp RIGHT_ALT  &kp RIGHT_SHIFT  &none
&none  &none  &kp N1        &kp NUMBER_2  &kp NUMBER_3  &kp COMMA    &none          &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &none          &none            &none
                            &kp DOT       &kp N0        &kp ENTER    &kp BACKSPACE  &trans                &trans
            >;

            label = "Numpad";
        };

        Media {
            bindings = <
&none  &bt0_rgb    &bt1_rgb       &bt2_rgb       &bt3_rgb  &bt4_rgb       &sys_reset         &kp F1           &kp F2         &kp F3   &kp F4   &none
&none  &kp K_MUTE  &kp C_VOL_DN   &kp C_VOL_UP   &none     &bootloader    &bootloader        &kp F5           &kp F6         &kp F7   &kp F8   &none
&none  &none       &kp C_BRI_DEC  &kp C_BRI_INC  &none     &bt BT_CLR     &none              &kp F9           &kp F10        &kp F11  &kp F12  &none
                                  &none          &none  &kp LEFT_GUI    &kp RIGHT_CONTROL  &kp RIGHT_SHIFT  &kp RIGHT_ALT
            >;

            label = "Media";
        };
    };

    conditional_layers { compatible = "zmk,conditional-layers"; };
};
